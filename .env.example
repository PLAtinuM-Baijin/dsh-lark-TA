# 复制为 /etc/dsh-lark-ta.env 或 systemd EnvironmentFile，权限 0600。
TA_APP_ID=cli_xxxxxxxxxxxxxxxx
TA_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TA_WORKSPACE=/srv/ta/workspace
TA_READ_DIRS=/srv/ta/course
TA_FILES_DIR=/srv/ta/workspace/files
TA_MEMORY_DIR=/srv/ta/memory
TA_SCHEDULE_FILE=/srv/ta/schedules.json
TA_HISTORY_DIR=/srv/ta/history
TA_DM_LIMIT_FILE=/srv/ta/dm-limits.json

# 群聊：课程群 + 助教/老师小群（小群必须是子集）
TA_GROUP_CHAT_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TA_MANAGER_CHAT_IDS=oc_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# 夜间整理：读取哪些群；其中哪些是公开群
TA_CURATOR_CHAT_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,oc_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
TA_PUBLIC_CHAT_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TA_CURATOR_TIME=03:17

TA_DM_DAILY_LIMIT=30
TA_CARD_STREAMING=true

# 精简版飞书 MCP（lark-mcp-dsh）部署目录与其 owner
TA_LARK_MCP_DIR=/opt/lark-mcp-dsh
TA_OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
